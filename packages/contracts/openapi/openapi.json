      "get": {
        "operationId": "listProfiles",
        "summary": "List profiles",
        "description": "Cursor-paginated, newest first. The cursor is the last id on the previous page, so a row inserted mid-pagination cannot shift a page boundary and make you skip or repeat an item — which offset pagination over an actively-written table does.\n\nRequires scope: `profiles:read`.",
        "tags": [
          "Profiles"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "external_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of profiles.",
            "headers": {
              "x-request-id": {
                "description": "Echoed request identifier. Quote this when reporting a problem.",
                "schema": {
                  "type": "string"
                }
