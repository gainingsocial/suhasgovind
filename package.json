{
  "name": "gaining-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-Native Unified Social API — social execution infrastructure for software and AI agents",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "db:generate": "pnpm --filter @gs/db db:generate",
    "db:migrate": "pnpm --filter @gs/db db:migrate",
    "openapi:emit": "pnpm --filter @gs/api openapi:emit",
    "openapi:check": "pnpm --filter @gs/api openapi:check",
    "docs:check": "pnpm --filter @gs/api docs:check",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries && pnpm openapi:check && pnpm docs:check && pnpm errors:check && pnpm build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ci:full": "pnpm run ci && pnpm test:integration",
    "setup:github": "node scripts/setup-github-actions.mjs",
    "errors:check": "pnpm --filter @gs/web errors:check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^17.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "libsodium-wrappers": "^0.8.4",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
