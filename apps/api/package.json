{
  "name": "@gs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --var ENVIRONMENT:test --var PUBLIC_API_ORIGIN:http://127.0.0.1:8787",
    "deploy": "wrangler deploy",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "openapi:check": "tsx scripts/emit-openapi.ts --check",
    "docs:check": "tsx scripts/check-error-docs.ts"
  },
  "dependencies": {
    "@gs/auth": "workspace:*",
    "@gs/contracts": "workspace:*",
    "@gs/db": "workspace:*",
    "@gs/errors": "workspace:*",
    "@gs/events": "workspace:*",
    "@gs/observability": "workspace:*",
    "@gs/platform-credentials": "workspace:*",
    "hono": "^4.10.3",
    "zod": "^4.4.3",
    "@gs/provider-kit": "workspace:*",
    "@gs/providers": "workspace:*",
    "@gs/domain": "workspace:*",
    "@gs/crypto": "workspace:*",
    "@gs/storage": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.120.0"
  }
}
