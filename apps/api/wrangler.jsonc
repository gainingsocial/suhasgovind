{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gs-api",
  "main": "src/index.ts",
  // Pinned deliberately. Plan §4.2 "Deployment rule": no unattended runtime upgrades.
  "compatibility_date": "2026-08-01",
  // Node built-ins used by `postgres` and the crypto helpers once the DB path is wired.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "test",
    "SERVICE_VERSION": "0.1.0",
    "LOG_LEVEL": "info",
    // Public discovery endpoint for the JWKS that verifies dashboard sessions (§39).
    // Not a secret, so a var rather than a Worker Secret.
    "SUPABASE_URL": "https://miemfmjjnsqhukxlvcmp.supabase.co",
    // The origin providers redirect back to, and the base of every hosted connect link
    // (§21.2, §22). Derived from the request when unset, which is right in development
    // and wrong the moment a proxy sits in front — so it is stated explicitly. It must
    // match what is registered in each platform's developer console exactly.
    "PUBLIC_API_ORIGIN": "http://127.0.0.1:8787"
  },
  "kv_namespaces": [
    {
      "binding": "IDEMPOTENCY",
      "id": "a52d1bbd993c49798cabd91e325a78b6"
    }
  ],
  // Producer bindings only. The consumers live in workers/publisher and
  // workers/customer-webhooks, which do not exist yet — a consumer declared here would
  // bind this Worker to messages it has no handler for.
  "queues": {
    "producers": [
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "gs-publish"
      },
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "gs-webhook-delivery"
      }
    ]
  },
  // Pooled Postgres. Connects as `gs_app` (migration 0002), never `postgres`, and reaches
  // Supabase's direct host — which is IPv6-only, and which Hyperdrive resolves fine.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "563bb35cce9040409987142c4d631c8e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gs-media-dev"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "live",
        "SERVICE_VERSION": "0.1.0",
        "LOG_LEVEL": "info",
        "SUPABASE_URL": "https://miemfmjjnsqhukxlvcmp.supabase.co",
        // Registered with every platform. Changing it invalidates every OAuth
        // registration at once, so it is pinned here rather than inferred per request.
        "PUBLIC_API_ORIGIN": "https://api.gainingsocial.com"
      },
      "kv_namespaces": [
        {
          "binding": "IDEMPOTENCY",
          "id": "a52d1bbd993c49798cabd91e325a78b6"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "PUBLISH_QUEUE",
            "queue": "gs-publish"
          },
          {
            "binding": "WEBHOOK_QUEUE",
            "queue": "gs-webhook-delivery"
          }
        ]
      },
      // A distinct config so production can be re-pointed at its own Supabase project
      // without touching this file. Both currently resolve to the same database —
      // Phase 0 calls for a separate production project, which is still outstanding.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "04758a98fb28438faae433e4b7bbf601"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "gs-media-prod"
        }
      ]
    }
  }
}
