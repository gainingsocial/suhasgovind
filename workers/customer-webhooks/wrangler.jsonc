{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gs-customer-webhooks",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "ENVIRONMENT": "test", "SERVICE_VERSION": "0.1.0", "LOG_LEVEL": "info" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "563bb35cce9040409987142c4d631c8e" }],
  "queues": {
    "producers": [{ "binding": "WEBHOOK_QUEUE", "queue": "gs-webhook-delivery" }],
    "consumers": [
      {
        "queue": "gs-webhook-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 5,
        // One queue attempt only. The retry ladder lives in the database and re-enqueues
        // explicitly, so letting the queue retry too would double the rate and
        // desynchronize it from the schedule the customer sees.
        "max_retries": 1,
        "dead_letter_queue": "gs-webhook-delivery-dlq"
      }
    ]
  }
}
