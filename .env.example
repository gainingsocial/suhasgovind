# =============================================================================
# Local development environment  (plan §84)
#
# Copy to `.env` for Node-side tooling (migrations, tests) and to
# `apps/api/.dev.vars` for `wrangler dev`.
#
# NOTHING in this file is a real secret. Real secrets live in
# Cloudflare Secrets Store / Worker Secrets (plan §6.6).
# =============================================================================

# ---- Database (Supabase Postgres; Workers reach it through Hyperdrive) ------
# Dedicated least-privilege application role — never the service_role key.
DATABASE_URL="postgresql://gs_app:password@127.0.0.1:54322/postgres"

# ---- Application-layer credential encryption (plan §7.1) --------------------
# Root KEK, base64 of 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Key versioning is mandatory from day one: CREDENTIAL_KEK_V1, _V2, ...
CREDENTIAL_KEK_V1="REPLACE_ME_base64_32_bytes"
CREDENTIAL_KEK_ACTIVE_VERSION="1"

# ---- API key hashing pepper (plan §38) --------------------------------------
# Keyed hash so a database dump alone cannot verify API keys offline.
API_KEY_HASH_PEPPER="REPLACE_ME_base64_32_bytes"

# ---- Outbound customer webhook signing (plan §36) ---------------------------
# Root from which per-endpoint signing secrets are derived.
WEBHOOK_SIGNING_ROOT="REPLACE_ME_base64_32_bytes"

# ---- Hosted connect session signing (plan §22) ------------------------------
CONNECT_SESSION_SIGNING_KEY="REPLACE_ME_base64_32_bytes"

# ---- Public URLs ------------------------------------------------------------
API_PUBLIC_URL="http://127.0.0.1:8787"
DASHBOARD_PUBLIC_URL="http://127.0.0.1:3000"
DOCS_PUBLIC_URL="https://gainingsocial.com/docs"

# ---- R2 media bucket (plan §31) ---------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="gs-media-dev"
R2_PUBLIC_BASE_URL=""

# ---- Supabase Auth for the dashboard (plan §39) -----------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---- Runtime behaviour ------------------------------------------------------
# `simulation` makes every provider call hit the mock adapter (plan §49).
NODE_ENV="development"
LOG_LEVEL="debug"
